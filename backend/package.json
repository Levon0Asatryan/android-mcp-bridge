{
  "name": "health-bridge-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "bash -c 'set -a; [ -f .env ] && . ./.env; set +a; wrangler deploy --var PUBLIC_ORIGIN:${PUBLIC_ORIGIN} --var PAIRING_RESET_EPOCH:${PAIRING_RESET_EPOCH:-0}'"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/server": "2.3.1",
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@modelcontextprotocol/client": "2.3.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  }
}
